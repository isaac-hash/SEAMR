# Copy to .env and adjust. All settings are optional.
LIFEOS_ENVIRONMENT=development
LIFEOS_LOG_LEVEL=INFO
LIFEOS_DATABASE_URL=sqlite:///./data/lifeos.db
# Seed 12 weeks of demo data on first run (use "Start fresh" in the app to clear it)
LIFEOS_SEED_DEMO_DATA=true

# Analytics tuning
LIFEOS_STREAK_THRESHOLD=0.7
LIFEOS_GROWTH_ALERT_PCT=10

# Optional: AI weekly review on the Reports page (rule-based observations work without it)
LIFEOS_ANTHROPIC_API_KEY=
LIFEOS_ANTHROPIC_MODEL=claude-sonnet-5-5
